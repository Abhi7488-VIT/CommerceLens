          }
        ],
        "lineageTag": "901f4e68-1328-40bf-9308-daa32631951a",
        "measures": [
          {
            "name": "Total Revenue",
            "description": "Gross item value plus freight, all statuses unless filtered. Not net recognized revenue; no refund data.",
            "displayFolder": "01 Core",
            "expression": "SUM(fact_order_items[revenue])",
            "formatString": "\"R$\" #,0.00;(\"R$\" #,0.00);\"R$\" 0.00",
            "lineageTag": "4550d573-0e27-4518-a620-702d64f591dd"
          },
          {
            "name": "Orders",
            "description": "Distinct order-grain rows; category/seller uses virtual order membership without double counting.",
            "displayFolder": "01 Core",
            "expression": [
              "VAR MatchingOrders = VALUES(fact_order_items[order_id])",
              "VAR ProductOrSellerFilter = ISCROSSFILTERED(dim_product) || ISCROSSFILTERED(dim_seller)",
              "RETURN IF(ProductOrSellerFilter,",
              "    CALCULATE(COUNTROWS(fact_orders), KEEPFILTERS(TREATAS(MatchingOrders, fact_orders[order_id]))),",
              "    COUNTROWS(fact_orders))"
            ],
            "formatString": "#,0",
            "lineageTag": "3614b5ae-2cea-43a7-b700-99cf4e0d5ebd"
          },
          {
            "name": "AOV",
            "description": "Selected item revenue divided by matching orders. Category selection gives selected-category spend per matching order.",
            "displayFolder": "01 Core",
            "expression": "DIVIDE([Total Revenue], [Orders])",
            "formatString": "\"R$\" #,0.00;(\"R$\" #,0.00);\"R$\" 0.00",
            "lineageTag": "3189660f-0e9e-4165-9e24-c89dd7f71b27"
          },
          {
            "name": "Delivered Orders",
            "description": "Delivered Orders",
            "displayFolder": "01 Core",
            "expression": "CALCULATE([Orders], KEEPFILTERS(fact_orders[order_status] = \"delivered\"))",
            "formatString": "#,0",
            "lineageTag": "91619d15-7cb6-46b5-ae09-f58415f43f56"
          },
          {
            "name": "Delivery Eligible Orders",
            "description": "Delivery Eligible Orders",
            "displayFolder": "02 Delivery",
            "expression": "CALCULATE([Delivered Orders], KEEPFILTERS(NOT ISBLANK(fact_orders[delay_days])))",
            "formatString": "#,0",
            "lineageTag": "4887fada-ec18-41f2-98e6-a702f806de64"
          },
          {
            "name": "Late Orders",
            "description": "Late Orders",
            "displayFolder": "02 Delivery",
            "expression": "CALCULATE([Delivery Eligible Orders], KEEPFILTERS(fact_orders[is_late] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "6f0c1405-7ee5-4935-a0c3-79026eabbab5"
          },
          {
            "name": "Late Delivery %",
            "description": "Delivered orders with positive calendar-day delay / delivered orders with both dates.",
            "displayFolder": "02 Delivery",
            "expression": "DIVIDE([Late Orders], [Delivery Eligible Orders])",
            "formatString": "0.00%",
            "lineageTag": "aa37f9b8-5223-49d1-8b06-5cbf02b290c8"
          },
          {
            "name": "Delay Sum",
            "description": "Delay Sum",
            "displayFolder": "02 Delivery",
            "expression": [
              "VAR MatchingOrders = VALUES(fact_order_items[order_id])",
              "VAR ProductOrSellerFilter = ISCROSSFILTERED(dim_product) || ISCROSSFILTERED(dim_seller)",
              "RETURN IF(ProductOrSellerFilter,",
              "    CALCULATE(SUM(fact_orders[delay_days]), KEEPFILTERS(TREATAS(MatchingOrders, fact_orders[order_id]))),",
              "    SUM(fact_orders[delay_days]))"
            ],
            "formatString": "#,0",
            "lineageTag": "eb80614f-419e-4d60-9870-c8c5c4b6d1ce"
          },
          {
            "name": "Avg Delay Days",
            "description": "Mean delay among late delivered orders only.",
            "displayFolder": "02 Delivery",
            "expression": "DIVIDE(CALCULATE([Delay Sum], KEEPFILTERS(fact_orders[order_status]=\"delivered\"), KEEPFILTERS(fact_orders[is_late]=TRUE())), [Late Orders])",
            "formatString": "0.0",
            "lineageTag": "e2c3ae35-6970-433a-9253-6f484fed9080"
          },
          {
            "name": "Review Points",
            "description": "Review Points",
            "displayFolder": "03 Reviews",
            "expression": [
              "VAR MatchingOrders = VALUES(fact_order_items[order_id])",
              "VAR ProductOrSellerFilter = ISCROSSFILTERED(dim_product) || ISCROSSFILTERED(dim_seller)",
              "RETURN IF(ProductOrSellerFilter,",
              "    CALCULATE(SUM(fact_orders[review_score]), KEEPFILTERS(TREATAS(MatchingOrders, fact_orders[order_id]))),",
              "    SUM(fact_orders[review_score]))"
            ],
            "formatString": "#,0",
            "lineageTag": "6c973109-6067-425b-a89a-6c038a2b4a69"
          },
          {
            "name": "Reviewed Orders",
            "description": "Reviewed Orders",
            "displayFolder": "03 Reviews",
            "expression": [
              "VAR MatchingOrders = VALUES(fact_order_items[order_id])",
              "VAR ProductOrSellerFilter = ISCROSSFILTERED(dim_product) || ISCROSSFILTERED(dim_seller)",
              "RETURN IF(ProductOrSellerFilter,",
              "    CALCULATE(COUNT(fact_orders[review_score]), KEEPFILTERS(TREATAS(MatchingOrders, fact_orders[order_id]))),",
              "    COUNT(fact_orders[review_score]))"
            ],
            "formatString": "#,0",
            "lineageTag": "ec34a436-c4d6-4440-95be-83f2aa14d1a9"
          },
          {
            "name": "Delivered Reviewed Orders",
            "description": "Delivered Reviewed Orders",
            "displayFolder": "03 Reviews",
            "expression": "CALCULATE([Reviewed Orders], KEEPFILTERS(fact_orders[order_status]=\"delivered\"))",
            "formatString": "#,0",
            "lineageTag": "394eb94f-0bc2-4c9e-a042-5e44ba0d66b0"
          },
          {
            "name": "Avg Review Score",
            "description": "Latest valid review per delivered order. Missing reviews are excluded, never scored as zero.",
            "displayFolder": "03 Reviews",
            "expression": "DIVIDE(CALCULATE([Review Points], KEEPFILTERS(fact_orders[order_status]=\"delivered\")), [Delivered Reviewed Orders])",
            "formatString": "0.00",
            "lineageTag": "6901c6d2-79a3-4354-bd2b-45e5037e1e1f"
          },
          {
            "name": "Low Review Orders",
            "description": "Low Review Orders",
            "displayFolder": "03 Reviews",
            "expression": "CALCULATE([Delivered Reviewed Orders], KEEPFILTERS(fact_orders[review_score] IN {1,2}))",
            "formatString": "#,0",
            "lineageTag": "74fa59e9-f3ed-4b2d-9d9e-cc37a57afc86"
          },
          {
            "name": "Low Review %",
            "description": "Low Review %",
            "displayFolder": "03 Reviews",
            "expression": "DIVIDE([Low Review Orders], [Delivered Reviewed Orders])",
            "formatString": "0.00%",
            "lineageTag": "ac2518a8-9a11-4d16-9722-824d42dbe064"
          },
          {
            "name": "Late Reviewed Orders",
            "description": "Late Reviewed Orders",
            "displayFolder": "03 Reviews",
            "expression": "CALCULATE([Delivered Reviewed Orders], KEEPFILTERS(fact_orders[is_late]=TRUE()), KEEPFILTERS(NOT ISBLANK(fact_orders[delay_days])))",
            "formatString": "#,0",
            "lineageTag": "429620d2-6821-42ba-a4b5-8d05485b92c1"
          },
          {
            "name": "On-time Reviewed Orders",
            "description": "On-time Reviewed Orders",
            "displayFolder": "03 Reviews",
            "expression": "CALCULATE([Delivered Reviewed Orders], KEEPFILTERS(fact_orders[is_late]==FALSE()), KEEPFILTERS(NOT ISBLANK(fact_orders[delay_days])))",
            "formatString": "#,0",
            "lineageTag": "b9a3fbbd-69a4-48d7-8e56-c95b8c857f6c"
          },
          {
            "name": "Low Review % (Late)",
            "description": "Low Review % (Late)",
            "displayFolder": "03 Reviews",
            "expression": "DIVIDE(CALCULATE([Low Review Orders], KEEPFILTERS(fact_orders[is_late]==TRUE()), KEEPFILTERS(NOT ISBLANK(fact_orders[delay_days]))), [Late Reviewed Orders])",
            "formatString": "0.00%",
            "lineageTag": "89ba7842-7c5b-448d-ae6d-fff0b1010291"
          },
          {
            "name": "Avg Rating (Late)",
            "description": "Avg Rating (Late)",
            "displayFolder": "03 Reviews",
            "expression": "CALCULATE([Avg Review Score], KEEPFILTERS(fact_orders[is_late]==TRUE()), KEEPFILTERS(NOT ISBLANK(fact_orders[delay_days])))",
            "formatString": "0.00",
            "lineageTag": "b37c94dc-864d-4014-96fd-0ca3f7518cc7"
          },
          {
            "name": "Low Review % (On-time)",
            "description": "Low Review % (On-time)",
            "displayFolder": "03 Reviews",
            "expression": "DIVIDE(CALCULATE([Low Review Orders], KEEPFILTERS(fact_orders[is_late]==FALSE()), KEEPFILTERS(NOT ISBLANK(fact_orders[delay_days]))), [On-time Reviewed Orders])",
            "formatString": "0.00%",
            "lineageTag": "b8c17e1a-352f-4664-812a-16447d5a8138"
          },
          {
            "name": "Avg Rating (On-time)",
            "description": "Avg Rating (On-time)",
            "displayFolder": "03 Reviews",
            "expression": "CALCULATE([Avg Review Score], KEEPFILTERS(fact_orders[is_late]==FALSE()), KEEPFILTERS(NOT ISBLANK(fact_orders[delay_days])))",
            "formatString": "0.00",
            "lineageTag": "549de594-6e9a-4ddd-9ba7-1daf93c97bc3"
          },
          {
            "name": "Late vs On-time Gap (pp)",
            "description": "Late vs On-time Gap (pp)",
            "displayFolder": "03 Reviews",
            "expression": [
              "VAR LateRate = [Low Review % (Late)]",
              "VAR OnTimeRate = [Low Review % (On-time)]",
              "RETURN IF(NOT ISBLANK(LateRate) && NOT ISBLANK(OnTimeRate), (LateRate-OnTimeRate)*100)"
            ],
            "formatString": "0.00 \"pp\"",
            "lineageTag": "129daa2b-66e0-4988-b2c7-53b82cb02306"
          },
          {
            "name": "Revenue MoM %",
            "description": "Uses purchase date. Edge months are partial; percent change is blank when prior revenue is zero/missing.",
            "displayFolder": "04 Time",
            "expression": [
              "VAR PriorMonth = CALCULATE([Total Revenue], DATEADD(dim_date[Date], -1, MONTH))",
              "RETURN DIVIDE([Total Revenue]-PriorMonth, PriorMonth)"
            ],
            "formatString": "0.0%",
            "lineageTag": "2a53b07e-129f-4199-bb6f-4ace3e04724a"
          },
          {
            "name": "Revenue YTD",
            "description": "Revenue YTD",
            "displayFolder": "04 Time",
            "expression": "TOTALYTD([Total Revenue], dim_date[Date])",
            "formatString": "\"R$\" #,0.00;(\"R$\" #,0.00);\"R$\" 0.00",
            "lineageTag": "758df298-c625-4a87-99e5-a49401c022fe"
          },
          {
            "name": "Revenue Same Period Last Year",
            "description": "Revenue Same Period Last Year",
            "displayFolder": "04 Time",
            "expression": "CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[Date]))",
            "formatString": "\"R$\" #,0.00;(\"R$\" #,0.00);\"R$\" 0.00",
            "lineageTag": "71cdd055-fce6-41b1-bd36-0b3b05de59b0"
          },
          {
            "name": "Delivered Customers",
            "description": "Delivered Customers",
            "displayFolder": "05 Customers",
            "expression": "COUNTROWS(FILTER(VALUES(dim_customer[customer_unique_id]), CALCULATE([Delivered Orders]) > 0))",
            "formatString": "#,0",
            "lineageTag": "c9c555c5-1a28-4318-8ad7-6f75d3b5c3dd"
          },
          {
            "name": "Repeat Customers",
            "description": "Repeat Customers",
            "displayFolder": "05 Customers",
            "expression": "COUNTROWS(FILTER(VALUES(dim_customer[customer_unique_id]), CALCULATE([Delivered Orders]) >= 2))",
            "formatString": "#,0",
            "lineageTag": "c7878ce0-2077-4c83-901f-812717214c49"
          },
          {
            "name": "Repeat Customer %",
            "description": "Customers with at least two delivered orders in current filter context / customers with at least one. Not cohort-adjusted retention.",
            "displayFolder": "05 Customers",
            "expression": "DIVIDE([Repeat Customers], [Delivered Customers])",
            "formatString": "0.00%",
            "lineageTag": "ca5305fb-0833-42b6-9b7d-f9979ea01bab"
          },
          {
            "name": "Customers by RFM Segment",
            "description": "Delivered customers in current filters, grouped by static RFM snapshot segment.",
            "displayFolder": "05 Customers",
            "expression": "[Delivered Customers]",
            "formatString": "#,0",
            "lineageTag": "f0420046-ca24-4753-b321-eb091ede0308"
          },
          {
            "name": "Revenue Share of Top 10 Categories",
            "description": "Revenue Share of Top 10 Categories",
            "displayFolder": "01 Core",
            "expression": [
              "VAR CategoryRevenue = ADDCOLUMNS(ALLSELECTED(dim_product[category]), \"@Revenue\", CALCULATE([Total Revenue]))",
              "VAR TopCategories = TOPN(10, CategoryRevenue, [@Revenue], DESC, dim_product[category], ASC)",
              "RETURN DIVIDE(SUMX(TopCategories, [@Revenue]), SUMX(CategoryRevenue, [@Revenue]))"
            ],
            "formatString": "0.0%",
            "lineageTag": "4ab8d35d-7301-47c9-8a6b-166a2422d50d"
          },
          {
            "name": "Top 10 Category Revenue",
            "description": "Top 10 Category Revenue",
            "displayFolder": "01 Core",
            "expression": [
              "VAR RankedCategories = ADDCOLUMNS(ALLSELECTED(dim_product[category]), \"@Revenue\", CALCULATE([Total Revenue]))",
              "VAR TopCategories = TOPN(10, RankedCategories, [@Revenue], DESC, dim_product[category], ASC)",
              "RETURN CALCULATE([Total Revenue], KEEPFILTERS(TopCategories))"
            ],
            "formatString": "\"R$\" #,0.00;(\"R$\" #,0.00);\"R$\" 0.00",
            "lineageTag": "b0382fca-3c01-4e31-97c2-799a47a3c94e"
          },
          {
            "name": "Late Reduction % Value",
            "description": "Disconnected what-if table, 0 to 100% in 5-point increments, default 50%.",
            "displayFolder": "06 Scenario",
            "expression": "SELECTEDVALUE('Late Reduction %'[Value], 0.50)",
            "formatString": "0%",
            "lineageTag": "0a4fb3f1-8635-487b-bdeb-9f5dedad6ad3"
          },
          {
            "name": "Late Orders Avoided",
            "description": "Late Orders Avoided",
            "displayFolder": "06 Scenario",
            "expression": [
              "VAR Reduction = [Late Reduction % Value]",
              "RETURN [Late Orders] * Reduction"
            ],
            "formatString": "#,0",
            "lineageTag": "bcc1ae04-7225-44c5-8103-de822539dfca"
          },
          {
            "name": "Low Reviews Avoided",
            "description": "Requested scenario extrapolates reviewed cohort rates to all late orders. Expected count, not a guaranteed outcome.",
            "displayFolder": "06 Scenario",
            "expression": [
              "VAR Gap = [Low Review % (Late)] - [Low Review % (On-time)]",
              "RETURN IF([Late Reviewed Orders]>0 && [On-time Reviewed Orders]>0, [Late Orders Avoided] * Gap)"
            ],
            "formatString": "#,0",
            "lineageTag": "f6c74764-6223-4390-bf4e-519928580f7b"
          },
          {
            "name": "Projected Avg Rating",
            "description": "Reassigns selected share of reviewed late orders to observed on-time mean; keeps review volume fixed. Associational scenario.",
            "displayFolder": "06 Scenario",
            "expression": [
              "VAR ReviewedLateShifted = [Late Reviewed Orders] * [Late Reduction % Value]",
              "VAR RatingUplift = [Avg Rating (On-time)] - [Avg Rating (Late)]",
              "VAR Baseline = [Avg Review Score]",
              "RETURN IF([Late Reviewed Orders]>0 && [On-time Reviewed Orders]>0,",
              "    MIN(5, MAX(1, Baseline + DIVIDE(ReviewedLateShifted * RatingUplift, [Delivered Reviewed Orders]))))"
            ],
            "formatString": "0.00",
            "lineageTag": "c8ec31b4-0045-467c-97f0-54e2aa954047"
          },
          {
            "name": "Scenario Rating",
            "description": "Scenario Rating",
            "displayFolder": "06 Scenario",
            "expression": "SWITCH(SELECTEDVALUE(Scenario[Scenario]), \"Before\", [Avg Review Score], \"After\", [Projected Avg Rating])",
            "formatString": "0.00",
            "lineageTag": "1765a10f-3537-4d37-a5e6-3a735099e9fa"
          },
          {
            "name": "Scenario Late Orders",
            "description": "Scenario Late Orders",
            "displayFolder": "06 Scenario",
            "expression": "SWITCH(SELECTEDVALUE(Scenario[Scenario]), \"Before\", [Late Orders], \"After\", [Late Orders]-[Late Orders Avoided])",
            "formatString": "#,0",
            "lineageTag": "8e6d2cd8-7c67-492a-a36c-b088dc7fa621"
          },
          {
            "name": "Delivery Insight",
            "description": "Delivery Insight",
            "displayFolder": "07 Narrative",
            "expression": [
              "VAR LateRate = [Low Review % (Late)]",
              "VAR OnTimeRate = [Low Review % (On-time)]",
              "RETURN IF(ISBLANK(LateRate) || ISBLANK(OnTimeRate), \"Insufficient reviewed orders for a cohort comparison\",",
              "\"Late deliveries receive 1–2 star reviews \" & FORMAT(LateRate,\"0.0%\") & \" of the time vs \" & FORMAT(OnTimeRate,\"0.0%\") & \" on-time\")"
            ],
            "formatString": "General",
            "lineageTag": "175b36dd-ac6c-4e86-8891-b80a1f8f7a27"
          },
          {
            "name": "Executive Insight",
            "description": "Executive Insight",
            "displayFolder": "07 Narrative",
            "expression": "\"Top 10 categories generate \" & FORMAT([Revenue Share of Top 10 Categories],\"0.0%\") & \" of gross sales. Prioritize delivery reliability in these categories.\"",
            "formatString": "General",
            "lineageTag": "9db36f25-d54e-4d2b-969e-903c57b05f0c"
          },
          {
            "name": "Scenario Insight",
            "description": "Scenario Insight",
            "displayFolder": "07 Narrative",
            "expression": "\"Illustrative scenario: \" & FORMAT([Late Reduction % Value],\"0%\") & \" fewer late orders. Observed cohort differences are associations, not causal effects.\"",
            "formatString": "General",
            "lineageTag": "8dea1063-b6e6-4fe9-b8f8-fe2f2ce77329"
          },
          {
            "name": "Retention Insight",
            "description": "Retention Insight",
            "displayFolder": "07 Narrative",
            "expression": "\"Only \" & FORMAT([Repeat Customer %],\"0.0%\") & \" of delivered customers purchased again within the selected observation window.\"",
            "formatString": "General",
            "lineageTag": "44f03cce-9d3d-4606-93f1-6663138ec5e8"
          }
        ],
