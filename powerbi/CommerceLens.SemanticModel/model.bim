          },
          {
            "name": "review_score",
            "dataType": "int64",
            "lineageTag": "65ad8a6f-364c-4b00-8d6b-546dcdfc2e6e",
            "sourceColumn": "review_score",
            "summarizeBy": "none"
          },
          {
            "name": "is_low_review",
