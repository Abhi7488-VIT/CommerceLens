{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/1.0.0/schema.json",
  "name": "Detail",
  "displayName": "State & Category Detail",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F2F4F5'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  },
  "visibility": "HiddenInViewMode",
  "pageBinding": {
    "name": "DetailBinding",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "State",
        "boundFilter": "DetailState",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_state"
              }
            },
            "Property": "state"
          }
        }
      },
      {
        "name": "Category",
        "boundFilter": "DetailCategory",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_product"
              }
            },
            "Property": "category"
          }
        }
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "DetailState",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_state"
              }
            },
            "Property": "state"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "DetailCategory",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_product"
              }
            },
            "Property": "category"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  }
}